{
  "db_name": "PostgreSQL",
  "query": "SELECT rejection_id, transformation_name, arguments, actor,\n                        kind, rule, invariant_version, reason, witness, compared,\n                        compared_branches, rejected_at\n                 FROM morpholog.rejections\n                 WHERE jsonb_path_exists(\n                     jsonb_build_array(arguments, witness, compared, compared_branches),\n                     '$.** ? (@.type == \"subject\" && @.value == $s)', $2)\n                 ORDER BY rejected_at DESC, rejection_id DESC\n                 LIMIT $1",
