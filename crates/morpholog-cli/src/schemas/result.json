{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Morpholog CLI outcome envelopes",
  "description": "Every machine-readable envelope the CLI prints on stdout, one $defs entry per shape. Programme-independent: these shapes vary only with the binary. Trace entry internals are deliberately unconstrained (reserved); see docs/embedder-integration.md.",
  "$defs": {
    "tagged_value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "subject" },
            "value": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "decimal" },
            "value": { "type": "string", "pattern": "^-?(0|[1-9]\\d*)(\\.\\d+)?$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "bool" },
            "value": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "date" },
            "value": { "type": "string", "format": "date" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "timestamp" },
            "value": { "type": "string", "format": "date-time" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "duration" },
            "value": { "type": "string", "format": "duration" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "quantity" },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "required": ["amount", "unit"],
              "properties": {
                "amount": { "type": "string", "pattern": "^-?(0|[1-9]\\d*)(\\.\\d+)?$" },
                "unit": { "type": "string" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "collection" },
            "value": { "type": "array", "items": { "$ref": "#/$defs/tagged_value" } }
          }
        }
      ]
    },
    "bare_value": {
      "oneOf": [
        { "type": "string" },
        { "type": "boolean" },
        { "type": "array", "items": { "$ref": "#/$defs/bare_value" } }
      ]
    },
    "witness_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["var", "value"],
      "properties": {
        "var": { "type": "string" },
        "value": { "$ref": "#/$defs/tagged_value" }
      }
    },
    "claim_instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate", "args"],
      "properties": {
        "predicate": { "type": "string" },
        "args": { "type": "array", "items": { "$ref": "#/$defs/tagged_value" } }
      }
    },
    "intent_instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "args"],
      "properties": {
        "name": { "type": "string" },
        "args": { "type": "array", "items": { "$ref": "#/$defs/tagged_value" } }
      }
    },
    "named_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate", "args"],
      "properties": {
        "predicate": { "type": "string" },
        "args": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/bare_value" }
        }
      }
    },
    "claim_instance_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim_instance" }
    },
    "named_claim_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/named_claim" }
    },
    "committed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "transition_id",
        "actor",
        "asserted_claims",
        "retracted_claims",
        "emitted_intents"
      ],
      "properties": {
        "status": { "const": "committed" },
        "transition_id": { "type": "string", "format": "uuid" },
        "actor": { "$ref": "#/$defs/tagged_value" },
        "asserted_claims": { "type": "array", "items": { "$ref": "#/$defs/claim_instance" } },
        "retracted_claims": { "type": "array", "items": { "$ref": "#/$defs/claim_instance" } },
        "emitted_intents": { "type": "array", "items": { "$ref": "#/$defs/intent_instance" } }
      }
    },
    "rejected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "const": "rejected" },
        "reason": { "type": "string" },
        "rule": { "type": "string" },
        "witness": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/witness_binding" } },
        "explanation": { "$ref": "#/$defs/explanation" }
      }
    },
    "run_outcome": {
      "oneOf": [{ "$ref": "#/$defs/committed" }, { "$ref": "#/$defs/rejected" }]
    },
    "errored": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "error"],
      "properties": {
        "status": { "const": "errored" },
        "error": { "type": "string" }
      }
    },
    "traced_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "trace"],
      "properties": {
        "result": {
          "oneOf": [{ "$ref": "#/$defs/run_outcome" }, { "$ref": "#/$defs/errored" }]
        },
        "trace": { "type": "array", "items": { "$ref": "#/$defs/trace_entry" } }
      }
    },
    "rendered_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate", "rendered"],
      "properties": {
        "predicate": { "type": "string" },
        "rendered": { "type": "string" }
      }
    },
    "require_outcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "match_count"],
          "properties": {
            "status": { "const": "held" },
            "match_count": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": { "const": "rejected" },
            "reason": { "type": "string" },
            "failing_sub_expression": { "type": "string" },
            "directly_missing_claims": {
              "type": "array",
              "items": { "$ref": "#/$defs/rendered_claim" }
            }
          }
        }
      ]
    },
    "bind_one_outcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "bindings"],
          "properties": {
            "status": { "const": "bound" },
            "bindings": { "type": "array", "items": { "$ref": "#/$defs/witness_binding" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "const": "no_match" },
            "failing_sub_expression": { "type": "string" },
            "directly_missing_claims": {
              "type": "array",
              "items": { "$ref": "#/$defs/rendered_claim" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "count"],
          "properties": {
            "status": { "const": "multiple_matches" },
            "count": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "for_iteration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "trace"],
      "properties": {
        "item": { "$ref": "#/$defs/tagged_value" },
        "trace": { "type": "array", "items": { "$ref": "#/$defs/trace_entry" } }
      }
    },
    "trace_entry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "expression", "outcome"],
          "properties": {
            "kind": { "const": "require" },
            "expression": { "type": "string" },
            "name": { "type": "string" },
            "outcome": { "$ref": "#/$defs/require_outcome" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "expression", "outcome"],
          "properties": {
            "kind": { "const": "bind_one" },
            "expression": { "type": "string" },
            "name": { "type": "string" },
            "outcome": { "$ref": "#/$defs/bind_one_outcome" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "value"],
          "properties": {
            "kind": { "const": "let" },
            "name": { "type": "string" },
            "value": { "$ref": "#/$defs/tagged_value" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "subject"],
          "properties": {
            "kind": { "const": "let_new_subject" },
            "name": { "type": "string" },
            "subject": { "$ref": "#/$defs/tagged_value" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "claim"],
          "properties": {
            "kind": { "const": "assert" },
            "claim": { "$ref": "#/$defs/claim_instance" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "predicate", "retracted"],
          "properties": {
            "kind": { "const": "retract" },
            "predicate": { "type": "string" },
            "retracted": { "$ref": "#/$defs/claim_instance_array" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "intent"],
          "properties": {
            "kind": { "const": "emit" },
            "intent": { "$ref": "#/$defs/intent_instance" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "binding", "iterations"],
          "properties": {
            "kind": { "const": "for" },
            "binding": { "type": "string" },
            "iterations": { "type": "array", "items": { "$ref": "#/$defs/for_iteration" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "expression", "held"],
          "properties": {
            "kind": { "const": "invariant_check" },
            "name": { "type": "string" },
            "expression": { "type": "string" },
            "held": { "type": "boolean" }
          }
        }
      ]
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transition", "verdict"],
      "properties": {
        "transition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["transformation", "args", "actor"],
          "properties": {
            "transformation": { "type": "string" },
            "args": { "type": "array", "items": { "type": "string" } },
            "actor": { "type": "string" }
          }
        },
        "verdict": {
          "oneOf": [
            { "const": "admissible" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["rejected"],
              "properties": { "rejected": { "$ref": "#/$defs/rejection" } }
            }
          ]
        }
      }
    },
    "rejection_row": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rejection_id", "transformation_name", "arguments", "actor",
            "kind", "rule", "invariant_version", "reason", "rejected_at"
          ],
          "properties": {
            "rejection_id": { "type": "string", "format": "uuid" },
            "transformation_name": { "type": "string" },
            "arguments": { "type": "array", "items": { "$ref": "#/$defs/tagged_value" } },
            "actor": { "$ref": "#/$defs/tagged_value" },
            "kind": { "const": "invariant" },
            "rule": { "type": "string" },
            "invariant_version": { "type": "integer" },
            "reason": { "type": "string" },
            "witness": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/witness_binding" } },
            "rejected_at": { "type": "string", "format": "date-time" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rejection_id", "transformation_name", "arguments", "actor",
            "kind", "rule", "reason", "rejected_at"
          ],
          "properties": {
            "rejection_id": { "type": "string", "format": "uuid" },
            "transformation_name": { "type": "string" },
            "arguments": { "type": "array", "items": { "$ref": "#/$defs/tagged_value" } },
            "actor": { "$ref": "#/$defs/tagged_value" },
            "kind": { "enum": ["require", "bind"] },
            "rule": { "type": "string" },
            "reason": { "type": "string" },
            "rejected_at": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "rejection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "gate", "statement_kind", "directly_missing_claims"],
          "properties": {
            "kind": { "const": "gate" },
            "gate": { "type": "string" },
            "rule": { "type": "string" },
            "statement_kind": { "enum": ["require", "bind_one"] },
            "directly_missing_claims": {
              "type": "array",
              "items": { "$ref": "#/$defs/missing_claim" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "rule"],
          "properties": {
            "kind": { "const": "invariant" },
            "name": { "type": "string" },
            "rule": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "message"],
          "properties": {
            "kind": { "const": "error" },
            "message": { "type": "string" }
          }
        }
      ]
    },
    "missing_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate", "rendered", "candidate_supplier_transformations"],
      "properties": {
        "predicate": { "type": "string" },
        "rendered": { "type": "string" },
        "candidate_supplier_transformations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "batch_receipt": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "row",
            "status",
            "transition_id",
            "actor",
            "asserted_claims",
            "retracted_claims",
            "emitted_intents"
          ],
          "properties": {
            "row": { "type": "integer", "minimum": 1 },
            "status": { "const": "committed" },
            "transition_id": { "type": "string", "format": "uuid" },
            "actor": { "$ref": "#/$defs/tagged_value" },
            "asserted_claims": { "type": "array", "items": { "$ref": "#/$defs/claim_instance" } },
            "retracted_claims": { "type": "array", "items": { "$ref": "#/$defs/claim_instance" } },
            "emitted_intents": { "type": "array", "items": { "$ref": "#/$defs/intent_instance" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["row", "status", "reason"],
          "properties": {
            "row": { "type": "integer", "minimum": 1 },
            "status": { "const": "rejected" },
            "reason": { "type": "string" },
            "rule": { "type": "string" },
            "witness": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/witness_binding" } },
            "explanation": { "$ref": "#/$defs/explanation" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["row", "status", "error"],
          "properties": {
            "row": { "type": "integer", "minimum": 1 },
            "status": { "const": "error" },
            "error": { "type": "string" }
          }
        }
      ]
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "authenticated_by"],
      "properties": {
        "mode": { "const": "gateway" },
        "authenticated_by": { "type": "string" }
      }
    },
    "audit_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_id",
        "transformation_name",
        "arguments",
        "actor",
        "invariant_epoch",
        "invariants_checked",
        "asserted_claims",
        "retracted_claims",
        "emitted_intents",
        "committed_at"
      ],
      "properties": {
        "transition_id": { "type": "string", "format": "uuid" },
        "transformation_name": { "type": "string" },
        "arguments": {
          "type": "array",
          "items": { "$ref": "#/$defs/tagged_value" }
        },
        "actor": { "$ref": "#/$defs/tagged_value" },
        "invariant_epoch": { "type": "integer" },
        "invariants_checked": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": { "type": "string" },
              "version": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "asserted_claims": {
          "type": "array",
          "items": { "$ref": "#/$defs/claim_instance" }
        },
        "retracted_claims": {
          "type": "array",
          "items": { "$ref": "#/$defs/claim_instance" }
        },
        "emitted_intents": {
          "type": "array",
          "items": { "$ref": "#/$defs/intent_instance" }
        },
        "committed_at": { "type": "string", "format": "date-time" },
        "attestation": { "$ref": "#/$defs/attestation" }
      }
    },
    "audit_row_named": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_id",
        "transformation_name",
        "arguments",
        "actor",
        "invariant_epoch",
        "invariants_checked",
        "asserted_claims",
        "retracted_claims",
        "emitted_intents",
        "committed_at"
      ],
      "properties": {
        "transition_id": { "type": "string", "format": "uuid" },
        "transformation_name": { "type": "string" },
        "arguments": {
          "type": "array",
          "items": { "$ref": "#/$defs/tagged_value" }
        },
        "actor": { "$ref": "#/$defs/tagged_value" },
        "invariant_epoch": { "type": "integer" },
        "invariants_checked": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": { "type": "string" },
              "version": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "asserted_claims": {
          "type": "array",
          "items": { "$ref": "#/$defs/named_claim" }
        },
        "retracted_claims": {
          "type": "array",
          "items": { "$ref": "#/$defs/named_claim" }
        },
        "emitted_intents": {
          "type": "array",
          "items": { "$ref": "#/$defs/intent_instance" }
        },
        "committed_at": { "type": "string", "format": "date-time" },
        "attestation": { "$ref": "#/$defs/attestation" }
      }
    },
    "outbox_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent_id",
        "transition_id",
        "intent_type",
        "arguments",
        "idempotency_key",
        "status",
        "attempt_count",
        "enqueued_at",
        "last_attempt_at",
        "delivered_at",
        "failed_at",
        "failure_reason",
        "next_attempt_at",
        "compensation_transition_id",
        "locked_by",
        "lock_expires_at"
      ],
      "properties": {
        "intent_id": { "type": "string", "format": "uuid" },
        "transition_id": { "type": "string", "format": "uuid" },
        "intent_type": { "type": "string" },
        "arguments": { "type": "array", "items": { "$ref": "#/$defs/tagged_value" } },
        "idempotency_key": { "type": "string" },
        "status": { "type": "string" },
        "attempt_count": { "type": "integer" },
        "enqueued_at": { "type": "string", "format": "date-time" },
        "last_attempt_at": { "type": ["string", "null"], "format": "date-time" },
        "delivered_at": { "type": ["string", "null"], "format": "date-time" },
        "failed_at": { "type": ["string", "null"], "format": "date-time" },
        "failure_reason": { "type": ["string", "null"] },
        "next_attempt_at": { "type": ["string", "null"], "format": "date-time" },
        "compensation_transition_id": { "type": ["string", "null"], "format": "uuid" },
        "locked_by": { "type": ["string", "null"] },
        "lock_expires_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "outbox_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row"],
      "properties": {
        "row": { "oneOf": [{ "$ref": "#/$defs/outbox_row" }, { "type": "null" }] }
      }
    },
    "outbox_update": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["applied", "lease_lost"] }
      }
    },
    "coverage_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program", "transitions_replayed", "rejections_replayed", "invariants", "transformations"],
      "properties": {
        "program": { "type": "string" },
        "transitions_replayed": { "type": "integer", "minimum": 0 },
        "rejections_replayed": { "type": "integer", "minimum": 0 },
        "invariants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["invariant", "verdict", "transitions_fired"],
            "properties": {
              "invariant": { "type": "string" },
              "from": { "type": "string" },
              "verdict": { "enum": ["constrained", "fired", "never_fired", "always_on"] },
              "transitions_fired": { "type": "integer", "minimum": 0 },
              "first_fired": { "type": "string" },
              "last_fired": { "type": "string" },
              "proposals_refused": { "type": "integer", "minimum": 1 },
              "first_refused": { "type": "string" },
              "last_refused": { "type": "string" },
              "not_in_programme": { "type": "boolean" }
            }
          }
        },
        "transformations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["transformation", "transitions"],
            "properties": {
              "transformation": { "type": "string" },
              "transitions": { "type": "integer", "minimum": 0 },
              "first": { "type": "string" },
              "last": { "type": "string" },
              "proposals_refused": { "type": "integer", "minimum": 1 },
              "not_in_programme": { "type": "boolean" }
            }
          }
        }
      }
    },
    "invariant_score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant", "version", "initially_holds", "would_refuse", "refused_transitions"],
      "properties": {
        "invariant": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "initially_holds": { "type": "boolean" },
        "would_refuse": { "type": "integer", "minimum": 0 },
        "refused_transitions": { "type": "array", "items": { "type": "string", "format": "uuid" } }
      }
    },
    "slice_score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transitions_replayed", "invariants"],
      "properties": {
        "transitions_replayed": { "type": "integer", "minimum": 0 },
        "invariants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["invariant", "version", "would_refuse", "refused_transitions"],
            "properties": {
              "invariant": { "type": "string" },
              "version": { "type": "integer", "minimum": 1 },
              "would_refuse": { "type": "integer", "minimum": 0 },
              "refused_transitions": { "type": "array", "items": { "type": "string", "format": "uuid" } }
            }
          }
        }
      }
    },
    "score_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score_format_version", "semantics", "program", "program_hash", "transitions_replayed", "invariants"],
      "properties": {
        "score_format_version": { "type": "integer", "minimum": 1 },
        "semantics": { "type": "string" },
        "program": { "type": "string" },
        "program_hash": { "type": "string", "pattern": "^sha256:" },
        "transitions_replayed": { "type": "integer", "minimum": 0 },
        "invariants": { "type": "array", "items": { "$ref": "#/$defs/invariant_score" } },
        "split": {
          "type": "object",
          "additionalProperties": false,
          "required": ["boundary", "train", "test"],
          "properties": {
            "boundary": {
              "type": "object",
              "additionalProperties": false,
              "required": ["requested", "resolved_transition_id", "resolved_committed_at"],
              "properties": {
                "requested": { "type": "string" },
                "resolved_transition_id": { "type": "string", "format": "uuid" },
                "resolved_committed_at": { "type": "string", "format": "date-time" }
              }
            },
            "train": { "$ref": "#/$defs/slice_score" },
            "test": { "$ref": "#/$defs/slice_score" }
          }
        }
      }
    },
    "batch_score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score_format_version", "semantics", "program", "program_hash", "cases"],
      "properties": {
        "score_format_version": { "type": "integer", "minimum": 1 },
        "semantics": { "type": "string" },
        "program": { "type": "string" },
        "program_hash": { "type": "string", "pattern": "^sha256:" },
        "cases": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["pack", "status", "transitions_replayed", "invariants"],
                "properties": {
                  "pack": { "type": "string" },
                  "status": { "const": "scored" },
                  "transitions_replayed": { "type": "integer", "minimum": 0 },
                  "invariants": { "type": "array", "items": { "$ref": "#/$defs/invariant_score" } }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["pack", "status", "error"],
                "properties": {
                  "pack": { "type": "string" },
                  "status": { "const": "failed" },
                  "error": { "type": "string" }
                }
              }
            ]
          }
        }
      }
    },
    "check_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "diagnostics"],
      "properties": {
        "file": { "type": "string" },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["severity", "message"],
            "properties": {
              "severity": { "enum": ["error", "hint"] },
              "message": { "type": "string" },
              "start": { "type": "integer" },
              "end": { "type": "integer" },
              "line": { "type": "integer" },
              "column": { "type": "integer" }
            }
          }
        }
      }
    },
    "hash_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program", "hash"],
      "properties": {
        "program": { "type": "string" },
        "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "migration_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "name"],
      "properties": {
        "version": { "type": "integer" },
        "name": { "type": "string" }
      }
    },
    "migration_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database_version", "binary_version", "applied", "pending"],
      "properties": {
        "database_version": { "type": "integer" },
        "binary_version": { "type": "integer" },
        "applied": { "type": "array", "items": { "$ref": "#/$defs/migration_ref" } },
        "pending": { "type": "array", "items": { "$ref": "#/$defs/migration_ref" } }
      }
    },
    "init_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "schema"],
      "properties": {
        "status": { "enum": ["initialised", "already-initialised"] },
        "schema": { "const": "morpholog" },
        "least_privilege": {
          "type": "object",
          "additionalProperties": false,
          "required": ["next_steps", "reader_role", "writer_role"],
          "properties": {
            "next_steps": { "type": "array", "items": { "type": "string" } },
            "reader_role": { "const": "morpholog_reader" },
            "writer_role": { "const": "morpholog_writer" }
          }
        }
      }
    },
    "refresh_derived_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derived_claim_count",
        "derived_predicate_count",
        "model_hash",
        "refresh_id",
        "source_claim_count"
      ],
      "dependentRequired": {
        "source_snapshot_committed_at": ["source_snapshot_transition_id"],
        "source_snapshot_transition_id": ["source_snapshot_committed_at"]
      },
      "properties": {
        "derived_claim_count": { "type": "integer", "minimum": 0 },
        "derived_predicate_count": { "type": "integer", "minimum": 0 },
        "model_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "refresh_id": { "type": "string", "format": "uuid" },
        "source_claim_count": { "type": "integer", "minimum": 0 },
        "source_snapshot_committed_at": { "type": "string", "format": "date-time" },
        "source_snapshot_transition_id": { "type": "string", "format": "uuid" }
      }
    },
    "tree_head_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "purpose", "public_key", "signature"],
      "properties": {
        "key_id": { "type": "string" },
        "purpose": { "type": "string" },
        "public_key": { "type": "string" },
        "signature": { "type": "string" }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tree_size", "root_hash", "prev_checkpoint_hash", "checkpoint_hash"],
      "properties": {
        "tree_size": { "type": "integer" },
        "root_hash": { "type": "string" },
        "prev_checkpoint_hash": { "type": ["string", "null"] },
        "checkpoint_hash": { "type": "string" },
        "signatures": { "type": "array", "items": { "$ref": "#/$defs/tree_head_signature" } }
      }
    },
    "checkpoint_outcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "tree_size", "root_hash", "prev_checkpoint_hash", "checkpoint_hash"],
          "properties": {
            "status": { "const": "created" },
            "tree_size": { "type": "integer" },
            "root_hash": { "type": "string" },
            "prev_checkpoint_hash": { "type": ["string", "null"] },
            "checkpoint_hash": { "type": "string" },
            "signatures": { "type": "array", "items": { "$ref": "#/$defs/tree_head_signature" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "tree_size", "root_hash", "prev_checkpoint_hash", "checkpoint_hash"],
          "properties": {
            "status": { "const": "no_new_rows" },
            "tree_size": { "type": "integer" },
            "root_hash": { "type": "string" },
            "prev_checkpoint_hash": { "type": ["string", "null"] },
            "checkpoint_hash": { "type": "string" },
            "signatures": { "type": "array", "items": { "$ref": "#/$defs/tree_head_signature" } }
          }
        }
      ]
    },
    "verify_outcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "transitions", "claims"],
          "properties": {
            "status": { "const": "consistent" },
            "transitions": { "type": "integer" },
            "claims": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "only_in_claims_table", "only_in_replay"],
          "properties": {
            "status": { "const": "divergent" },
            "only_in_claims_table": { "type": "array", "items": { "$ref": "#/$defs/claim_instance" } },
            "only_in_replay": { "type": "array", "items": { "$ref": "#/$defs/claim_instance" } }
          }
        }
      ]
    },
    "tree_verification": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "checkpoints", "tree_size"],
          "properties": {
            "status": { "const": "intact" },
            "checkpoints": { "type": "integer" },
            "tree_size": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "tree_size", "recorded_root", "recomputed_root"],
          "properties": {
            "status": { "const": "tampered" },
            "tree_size": { "type": "integer" },
            "recorded_root": { "type": "string" },
            "recomputed_root": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "detail"],
          "properties": {
            "status": { "const": "chain_broken" },
            "detail": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "tree_size", "anchor_checkpoint_hash", "stored_checkpoint_hash"],
          "properties": {
            "status": { "const": "anchor_mismatch" },
            "tree_size": { "type": "integer" },
            "anchor_checkpoint_hash": { "type": "string" },
            "stored_checkpoint_hash": { "type": ["string", "null"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "detail"],
          "properties": {
            "status": { "const": "malformed_pack" },
            "detail": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "tree_size", "key_id", "purpose", "public_key"],
          "properties": {
            "status": { "const": "signature_invalid" },
            "tree_size": { "type": "integer" },
            "key_id": { "type": "string" },
            "purpose": { "type": "string" },
            "public_key": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "tree_size", "key_id", "purpose", "public_key"],
          "properties": {
            "status": { "const": "unauthorized_key" },
            "tree_size": { "type": "integer" },
            "key_id": { "type": "string" },
            "purpose": { "type": "string" },
            "public_key": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "tree_size"],
          "properties": {
            "status": { "const": "signature_required" },
            "tree_size": { "type": "integer" }
          }
        }
      ]
    },
    "views_verification": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "views_checked"],
          "properties": {
            "status": { "const": "intact" },
            "views_checked": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "mismatched", "missing"],
          "properties": {
            "status": { "const": "tampered" },
            "mismatched": { "type": "array", "items": { "type": "string" } },
            "missing": { "type": "array", "items": { "type": "string" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "const": "not_sealed" }
          }
        }
      ]
    },
    "verify_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replay", "tree"],
      "properties": {
        "replay": { "$ref": "#/$defs/verify_outcome" },
        "tree": { "$ref": "#/$defs/tree_verification" },
        "views": { "$ref": "#/$defs/views_verification" }
      }
    },
    "pack_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack_format_version", "tree_size", "root_hash", "checkpoint_hash"],
      "properties": {
        "pack_format_version": { "type": "integer" },
        "tree_size": { "type": "integer" },
        "root_hash": { "type": "string" },
        "checkpoint_hash": { "type": "string" }
      }
    },
    "evidence_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "checkpoints", "rows"],
      "properties": {
        "manifest": { "$ref": "#/$defs/pack_manifest" },
        "checkpoints": { "type": "array", "items": { "$ref": "#/$defs/checkpoint" } },
        "rows": { "type": "array", "items": { "$ref": "#/$defs/audit_row" } }
      }
    },
    "row_inclusion_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leaf_index", "proof"],
      "properties": {
        "leaf_index": { "type": "integer" },
        "proof": { "type": "array", "items": { "type": "string" } }
      }
    },
    "window_pack_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack_format_version", "pack_kind", "from_tree_size", "to_tree_size", "from_checkpoint_hash", "to_checkpoint_hash", "from_root_hash", "to_root_hash"],
      "properties": {
        "pack_format_version": { "type": "integer" },
        "pack_kind": { "type": "string" },
        "from_tree_size": { "type": "integer" },
        "to_tree_size": { "type": "integer" },
        "from_checkpoint_hash": { "type": "string" },
        "to_checkpoint_hash": { "type": "string" },
        "from_root_hash": { "type": "string" },
        "to_root_hash": { "type": "string" }
      }
    },
    "window_evidence_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "from_checkpoint", "to_checkpoint", "consistency_proof", "rows", "inclusion_proofs"],
      "properties": {
        "manifest": { "$ref": "#/$defs/window_pack_manifest" },
        "from_checkpoint": { "$ref": "#/$defs/checkpoint" },
        "to_checkpoint": { "$ref": "#/$defs/checkpoint" },
        "consistency_proof": { "type": "array", "items": { "type": "string" } },
        "rows": { "type": "array", "items": { "$ref": "#/$defs/audit_row" } },
        "inclusion_proofs": { "type": "array", "items": { "$ref": "#/$defs/row_inclusion_proof" } }
      }
    },
    "window_verification": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "from_tree_size", "to_tree_size", "rows"],
          "properties": {
            "status": { "const": "intact" },
            "from_tree_size": { "type": "integer" },
            "to_tree_size": { "type": "integer" },
            "rows": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "from_tree_size", "to_tree_size"],
          "properties": {
            "status": { "const": "inconsistent_extension" },
            "from_tree_size": { "type": "integer" },
            "to_tree_size": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "leaf_index"],
          "properties": {
            "status": { "const": "row_not_included" },
            "leaf_index": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "tree_size", "anchor_checkpoint_hash", "pack_checkpoint_hash"],
          "properties": {
            "status": { "const": "anchor_mismatch" },
            "tree_size": { "type": "integer" },
            "anchor_checkpoint_hash": { "type": "string" },
            "pack_checkpoint_hash": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "tree_size", "key_id", "purpose", "public_key"],
          "properties": {
            "status": { "const": "signature_invalid" },
            "tree_size": { "type": "integer" },
            "key_id": { "type": "string" },
            "purpose": { "type": "string" },
            "public_key": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "tree_size"],
          "properties": {
            "status": { "const": "signature_required" },
            "tree_size": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "detail"],
          "properties": {
            "status": { "const": "malformed" },
            "detail": { "type": "string" }
          }
        }
      ]
    },
    "selective_pack_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack_format_version", "pack_kind", "tree_size", "root_hash", "checkpoint_hash"],
      "properties": {
        "pack_format_version": { "type": "integer" },
        "pack_kind": { "type": "string" },
        "tree_size": { "type": "integer" },
        "root_hash": { "type": "string" },
        "checkpoint_hash": { "type": "string" }
      }
    },
    "selective_evidence_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "checkpoint", "rows", "inclusion_proofs"],
      "properties": {
        "manifest": { "$ref": "#/$defs/selective_pack_manifest" },
        "checkpoint": { "$ref": "#/$defs/checkpoint" },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/audit_row" }
        },
        "inclusion_proofs": {
          "type": "array",
          "items": { "$ref": "#/$defs/row_inclusion_proof" }
        }
      }
    },
    "selective_verification": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "tree_size", "rows_disclosed"],
          "properties": {
            "status": { "const": "intact" },
            "tree_size": { "type": "integer" },
            "rows_disclosed": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "leaf_index"],
          "properties": {
            "status": { "const": "row_not_included" },
            "leaf_index": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "tree_size", "anchor_checkpoint_hash", "pack_checkpoint_hash"],
          "properties": {
            "status": { "const": "anchor_mismatch" },
            "tree_size": { "type": "integer" },
            "anchor_checkpoint_hash": { "type": "string" },
            "pack_checkpoint_hash": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "tree_size", "key_id", "purpose", "public_key"],
          "properties": {
            "status": { "const": "signature_invalid" },
            "tree_size": { "type": "integer" },
            "key_id": { "type": "string" },
            "purpose": { "type": "string" },
            "public_key": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "tree_size"],
          "properties": {
            "status": { "const": "signature_required" },
            "tree_size": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "detail"],
          "properties": {
            "status": { "const": "malformed" },
            "detail": { "type": "string" }
          }
        }
      ]
    }
  }
}
